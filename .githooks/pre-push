#!/usr/bin/env bash
# Validate every ref being published, retaining stdin for the global attribution dispatcher.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
head=$(git rev-parse HEAD)
zero=0000000000000000000000000000000000000000
count=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" != "$zero" ] || continue
  [ "$local_sha" = "$head" ] || { echo "push gate covers HEAD only; publish other commits from their own checkout" >&2; exit 1; }
  count=$((count + 1))
done
[ "$count" -gt 0 ] || exit 0
# fleet-gate binds the complete working snapshot to HEAD; inherited buildHost/recursion
# flags cannot turn this outer hook into a workstation build or bypass a gate part.
unset NRESE_GATE_INNER
exec bash scripts/check.sh push

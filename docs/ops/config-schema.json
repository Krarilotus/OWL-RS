{
  "$id": "https://nrese.dev/schema/config.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ai": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "description": "Whether AI query suggestions are offered.",
          "type": "boolean",
          "x-env": "NRESE_AI_ENABLED"
        },
        "gemini": {
          "additionalProperties": false,
          "properties": {
            "api_base": {
              "default": "https://generativelanguage.googleapis.com",
              "description": "The Gemini API's base URL.",
              "type": "string",
              "x-env": "NRESE_AI_GOOGLE_API_BASE"
            },
            "api_key": {
              "description": "The Gemini API key.",
              "type": "string",
              "writeOnly": true,
              "x-env": "NRESE_AI_GOOGLE_API_KEY"
            }
          },
          "type": "object"
        },
        "max_suggestions": {
          "default": 4,
          "description": "Suggestions per request.",
          "minimum": 0,
          "type": "integer",
          "x-env": "NRESE_AI_MAX_SUGGESTIONS"
        },
        "model": {
          "default": "gemini-2.5-flash",
          "description": "The provider's model.",
          "type": "string",
          "x-env": "NRESE_AI_MODEL"
        },
        "openrouter": {
          "additionalProperties": false,
          "properties": {
            "api_base": {
              "default": "https://openrouter.ai/api/v1",
              "description": "The OpenRouter API's base URL.",
              "type": "string",
              "x-env": "NRESE_AI_OPENROUTER_API_BASE"
            },
            "api_key": {
              "description": "The OpenRouter API key.",
              "type": "string",
              "writeOnly": true,
              "x-env": "NRESE_AI_OPENROUTER_API_KEY"
            },
            "app_name": {
              "description": "The application name sent to OpenRouter.",
              "type": "string",
              "x-env": "NRESE_AI_OPENROUTER_APP_NAME"
            },
            "site_url": {
              "description": "The site URL sent to OpenRouter.",
              "type": "string",
              "x-env": "NRESE_AI_OPENROUTER_SITE_URL"
            }
          },
          "type": "object"
        },
        "provider": {
          "default": "disabled",
          "description": "Who makes the suggestions.",
          "enum": [
            "disabled",
            "gemini",
            "openrouter"
          ],
          "type": "string",
          "x-env": "NRESE_AI_PROVIDER"
        },
        "system_prompt": {
          "default": "You generate concise SPARQL query ideas for an RDF and OWL knowledge graph. Return strict JSON only. Prefer safe read queries. Use prefixes only when you can justify them from the prompt or context. If uncertain, use full IRIs.",
          "description": "The system prompt of suggestion requests.",
          "type": "string",
          "x-env": "NRESE_AI_SYSTEM_PROMPT"
        },
        "timeout_ms": {
          "default": 20000,
          "description": "Per suggestion request, in milliseconds.",
          "minimum": 0,
          "type": "integer",
          "x-env": "NRESE_AI_TIMEOUT_MS"
        }
      },
      "type": "object"
    },
    "auth": {
      "additionalProperties": false,
      "properties": {
        "access_policy": {
          "description": "An access policy file, imported into the access state at the first start.",
          "type": "string",
          "x-env": "NRESE_ACCESS_POLICY"
        },
        "bearer_jwt": {
          "additionalProperties": false,
          "properties": {
            "admin_role": {
              "default": "nrese.admin",
              "description": "The role that may administer.",
              "type": "string",
              "x-env": "NRESE_AUTH_JWT_ADMIN_ROLE"
            },
            "audience": {
              "description": "The audience JWTs must name.",
              "type": "string",
              "x-env": "NRESE_AUTH_JWT_AUDIENCE"
            },
            "issuer": {
              "description": "The issuer JWTs must name.",
              "type": "string",
              "x-env": "NRESE_AUTH_JWT_ISSUER"
            },
            "leeway_seconds": {
              "default": 30,
              "description": "Clock leeway for expiry checks, in seconds.",
              "minimum": 0,
              "type": "integer",
              "x-env": "NRESE_AUTH_JWT_LEEWAY_SECS"
            },
            "read_role": {
              "default": "nrese.read",
              "description": "The role that may read.",
              "type": "string",
              "x-env": "NRESE_AUTH_JWT_READ_ROLE"
            },
            "shared_secret": {
              "description": "The HMAC secret JWTs are signed with.",
              "type": "string",
              "writeOnly": true,
              "x-env": "NRESE_AUTH_JWT_SECRET"
            }
          },
          "type": "object"
        },
        "bearer_static": {
          "additionalProperties": false,
          "properties": {
            "admin_token": {
              "description": "The static bearer token that may administer.",
              "type": "string",
              "writeOnly": true,
              "x-env": "NRESE_AUTH_ADMIN_TOKEN"
            },
            "read_token": {
              "description": "The static bearer token that may read.",
              "type": "string",
              "writeOnly": true,
              "x-env": "NRESE_AUTH_READ_TOKEN"
            }
          },
          "type": "object"
        },
        "local_logins": {
          "default": true,
          "description": "Whether users of the access state log in with passwords.",
          "type": "boolean",
          "x-env": "NRESE_AUTH_LOCAL_LOGINS"
        },
        "mode": {
          "default": "none",
          "description": "How requests are authenticated.",
          "enum": [
            "none",
            "bearer-static",
            "bearer-jwt",
            "mtls",
            "oidc-introspection"
          ],
          "type": "string",
          "x-env": "NRESE_AUTH_MODE"
        },
        "mtls": {
          "additionalProperties": false,
          "properties": {
            "admin_subjects": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ],
              "description": "The subjects that may administer.",
              "x-env": "NRESE_AUTH_MTLS_ADMIN_SUBJECTS"
            },
            "read_subjects": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ],
              "description": "The subjects that may read.",
              "x-env": "NRESE_AUTH_MTLS_READ_SUBJECTS"
            },
            "subject_header": {
              "default": "x-client-cert-subject",
              "description": "The header the TLS-terminating proxy passes the client certificate's subject in.",
              "type": "string",
              "x-env": "NRESE_AUTH_MTLS_SUBJECT_HEADER"
            },
            "trusted_proxies": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ],
              "default": "127.0.0.0/8,::1",
              "description": "The peers (addresses or ranges) that may send the subject header.",
              "x-env": "NRESE_AUTH_MTLS_TRUSTED_PROXIES"
            }
          },
          "type": "object"
        },
        "oidc_introspection": {
          "additionalProperties": false,
          "properties": {
            "admin_role": {
              "default": "nrese.admin",
              "description": "The role that may administer.",
              "type": "string",
              "x-env": "NRESE_AUTH_OIDC_ADMIN_ROLE"
            },
            "client_id": {
              "description": "The client id the server introspects as.",
              "type": "string",
              "x-env": "NRESE_AUTH_OIDC_CLIENT_ID"
            },
            "client_secret": {
              "description": "The client secret the server introspects with.",
              "type": "string",
              "writeOnly": true,
              "x-env": "NRESE_AUTH_OIDC_CLIENT_SECRET"
            },
            "introspection_url": {
              "description": "The OAuth 2.0 token introspection endpoint.",
              "type": "string",
              "x-env": "NRESE_AUTH_OIDC_INTROSPECTION_URL"
            },
            "read_role": {
              "default": "nrese.read",
              "description": "The role that may read.",
              "type": "string",
              "x-env": "NRESE_AUTH_OIDC_READ_ROLE"
            },
            "timeout_ms": {
              "default": 5000,
              "description": "Per introspection request, in milliseconds.",
              "minimum": 0,
              "type": "integer",
              "x-env": "NRESE_AUTH_OIDC_TIMEOUT_MS"
            }
          },
          "type": "object"
        },
        "trusted_proxies": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "default": "127.0.0.0/8,::1",
          "description": "The proxies (addresses or ranges) whose X-Forwarded-For names the client, for login throttling.",
          "x-env": "NRESE_AUTH_TRUSTED_PROXIES"
        },
        "workspace_base": {
          "default": "urn:nrese:",
          "description": "What personal space and workspace graph prefixes start with.",
          "type": "string",
          "x-env": "NRESE_WORKSPACE_BASE"
        }
      },
      "type": "object"
    },
    "budgets": {
      "additionalProperties": false,
      "properties": {
        "bulk_load_memory": {
          "default": "25%",
          "description": "The quads of a bulk load before they are sorted in chunks and spilled; 0 is unlimited.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_BULK_LOAD_MEMORY",
          "x-unit": "bytes-or-share"
        },
        "graph_read_timeout": {
          "default": "30s",
          "description": "A Graph Store or statements read.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_GRAPH_READ_TIMEOUT_MS",
          "x-older-keys": [
            "policy.timeouts.graph_read_ms"
          ],
          "x-unit": "milliseconds"
        },
        "graph_write_timeout": {
          "default": "60s",
          "description": "A Graph Store write.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_GRAPH_WRITE_TIMEOUT_MS",
          "x-older-keys": [
            "policy.timeouts.graph_write_ms"
          ],
          "x-unit": "milliseconds"
        },
        "huge_pages": {
          "default": "on",
          "description": "Transparent huge pages for the server's memory (Linux): on is faster over large heaps, off holds less memory while serving, bulk has them only while a bulk load or a materialisation runs.",
          "enum": [
            "off",
            "on",
            "bulk"
          ],
          "type": "string",
          "x-env": "NRESE_HUGE_PAGES"
        },
        "process_memory": {
          "default": "75%",
          "description": "The memory the server may hold before a materialisation or a commit's reasoning stops with an error instead of taking the machine; 0 is unlimited.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_PROCESS_MEMORY_BYTES",
          "x-unit": "bytes-or-share"
        },
        "query_memory": {
          "default": "4GiB",
          "description": "One query's memory envelope: its intermediate and retained results and, under owl2-dl, its DL work; 0 is unlimited.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_MAX_QUERY_MEMORY_BYTES",
          "x-older-keys": [
            "policy.limits.max_query_memory_bytes"
          ],
          "x-unit": "bytes-or-share"
        },
        "query_text": {
          "default": "1MiB",
          "description": "The text of a query.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_MAX_QUERY_BYTES",
          "x-older-keys": [
            "policy.limits.max_query_bytes"
          ],
          "x-unit": "bytes"
        },
        "query_timeout": {
          "default": "30s",
          "description": "A query, until its last result is sent.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_QUERY_TIMEOUT_MS",
          "x-older-keys": [
            "policy.timeouts.query_ms"
          ],
          "x-unit": "milliseconds"
        },
        "reasoning_release": {
          "default": "off",
          "description": "Memory given back between a materialisation's rounds: on lowers and steadies its peak (LUBM 100 by 14 %) for more reasoning time (5.6 %).",
          "enum": [
            "off",
            "on"
          ],
          "type": "string",
          "x-env": "NRESE_REASONING_RELEASE"
        },
        "result_cache": {
          "description": "Results of query parts (id columns) kept for repeated queries and shared sub-patterns; 0 switches the cache off. Unset: 2% of the process's memory, kept between 64MiB and 8GiB (64MiB where the memory can't be read); a share set explicitly is taken as written, without those bounds.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_QUERY_CACHE_BYTES",
          "x-older-keys": [
            "store.query_cache_bytes"
          ],
          "x-unit": "bytes-or-share"
        },
        "result_cache_pins": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "SPARQL query files whose results are pinned in the result cache at startup, each under its file name without the extension.",
          "x-env": "NRESE_PINNED_QUERIES"
        },
        "total_query_memory": {
          "default": "50%",
          "description": "Every running request's envelope across the catalog: queries, updates, DL entailment checks and explanations; 0 is unlimited.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_MAX_TOTAL_QUERY_MEMORY_BYTES",
          "x-unit": "bytes-or-share"
        },
        "update_size": {
          "default": "16MiB",
          "description": "A SPARQL update request.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_MAX_UPDATE_BYTES",
          "x-older-keys": [
            "policy.limits.max_update_bytes"
          ],
          "x-unit": "bytes"
        },
        "update_timeout": {
          "default": "60s",
          "description": "A SPARQL update, reasoning included.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_UPDATE_TIMEOUT_MS",
          "x-older-keys": [
            "policy.timeouts.update_ms"
          ],
          "x-unit": "milliseconds"
        },
        "upload_size": {
          "default": "128MiB",
          "description": "An RDF payload.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_MAX_RDF_UPLOAD_BYTES",
          "x-older-keys": [
            "policy.limits.max_rdf_upload_bytes"
          ],
          "x-unit": "bytes"
        }
      },
      "type": "object"
    },
    "dl": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "default": "certain-where-complete",
          "description": "Under owl2-dl, which answers a query returns: the certain ones where they can be proven complete and the sound ones otherwise, the sound lower bound alone, or certain answers or an error.",
          "enum": [
            "certain-where-complete",
            "sound",
            "exact"
          ],
          "type": "string",
          "x-env": "NRESE_DL_ANSWERS"
        },
        "consistency": {
          "default": "inline",
          "description": "Under owl2-dl, whether each commit is checked for consistency and rejected if it makes the data inconsistent (inline) or not checked (off).",
          "enum": [
            "inline",
            "off"
          ],
          "type": "string",
          "x-env": "NRESE_DL_CONSISTENCY"
        },
        "explanation_tests": {
          "default": "unlimited",
          "description": "Under owl2-dl, the entailment tests one explanation or rejection evidence runs; past them the justification isn't minimal.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_DL_EXPLANATION_TESTS",
          "x-unit": "count",
          "x-unlimited": [
            "0",
            "unlimited"
          ]
        },
        "lower_bound_timeout": {
          "default": "60s",
          "description": "Under owl2-dl, the time a classification's Horn lower bound may take, at most half of what is left: a route threshold, past it the hypertableau decides (0 or unlimited: only the half).",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_DL_LOWER_BOUND_TIMEOUT_MS",
          "x-unit": "milliseconds",
          "x-unlimited": [
            "0",
            "unlimited"
          ]
        },
        "max_branch_points": {
          "default": "unlimited",
          "description": "Under owl2-dl, the most branch points one hypertableau run may open: a deterministic budget; past it the run decides nothing.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_DL_MAX_BRANCH_POINTS",
          "x-unit": "count",
          "x-unlimited": [
            "0",
            "unlimited"
          ]
        },
        "max_candidates": {
          "default": 1000,
          "description": "Under owl2-dl, the candidate answers a query checks with the exact services at most; the rest are reported unresolved (0 or unlimited: none).",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_DL_MAX_CANDIDATES",
          "x-unit": "count",
          "x-unlimited": [
            "0",
            "unlimited"
          ]
        },
        "max_join": {
          "default": 1048576,
          "description": "Under owl2-dl, the most conclusions one join of the context core may produce: a route threshold, past it the hypertableau decides.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_DL_MAX_JOIN",
          "x-unit": "count",
          "x-unlimited": [
            "0",
            "unlimited"
          ]
        },
        "max_join_steps": {
          "default": 65536,
          "description": "Under owl2-dl, the most steps one Pred join of the context core may take: a route threshold, past it the hypertableau decides.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_DL_MAX_JOIN_STEPS",
          "x-unit": "count",
          "x-unlimited": [
            "0",
            "unlimited"
          ]
        },
        "max_merges": {
          "default": "unlimited",
          "description": "Under owl2-dl, the most merges one hypertableau run may make: a deterministic budget.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_DL_MAX_MERGES",
          "x-unit": "count",
          "x-unlimited": [
            "0",
            "unlimited"
          ]
        },
        "max_nodes": {
          "default": "unlimited",
          "description": "Under owl2-dl, the most nodes one hypertableau run may hold: a deterministic budget for reproducible runs.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_DL_MAX_NODES",
          "x-unit": "count",
          "x-unlimited": [
            "0",
            "unlimited"
          ]
        },
        "memory": {
          "default": "unlimited",
          "description": "Under owl2-dl, what one engine run may hold of its own, checked at work boundaries (0 or unlimited: none, and a request's runs draw from its memory envelope, budgets.query_memory).",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_DL_MEMORY",
          "x-unit": "bytes",
          "x-unlimited": [
            "0",
            "unlimited"
          ]
        },
        "threads": {
          "default": 0,
          "description": "Under owl2-dl, the workers of a classification (0: every core).",
          "minimum": 0,
          "type": "integer",
          "x-env": "NRESE_DL_THREADS"
        },
        "timeout": {
          "default": "30min",
          "description": "Under owl2-dl, the time one DL task may take: a commit's consistency check, a query's exact services, a classification (0 or unlimited: none).",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_DL_TIMEOUT_MS",
          "x-unit": "milliseconds",
          "x-unlimited": [
            "0",
            "unlimited"
          ]
        }
      },
      "type": "object"
    },
    "federation": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "The endpoints SERVICE may call (IRIs or prefixes, * for any).",
          "x-env": "NRESE_FEDERATION_ALLOW"
        },
        "max_rows": {
          "default": 1000000,
          "description": "Rows one request may return.",
          "minimum": 0,
          "type": "integer",
          "x-env": "NRESE_FEDERATION_MAX_ROWS"
        },
        "timeout": {
          "default": "30s",
          "description": "Per request to an endpoint.",
          "minimum": 0,
          "type": [
            "integer",
            "string"
          ],
          "x-env": "NRESE_FEDERATION_TIMEOUT_MS",
          "x-unit": "milliseconds"
        }
      },
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "exposure": {
          "additionalProperties": false,
          "properties": {
            "metrics": {
              "default": true,
              "description": "Whether the Prometheus metrics are served.",
              "type": "boolean",
              "x-env": "NRESE_ENABLE_METRICS"
            },
            "operator_ui": {
              "default": true,
              "description": "Whether the operator console is served.",
              "type": "boolean",
              "x-env": "NRESE_ENABLE_OPERATOR_UI"
            }
          },
          "type": "object"
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "max_query_bytes": {
              "default": "1MiB",
              "deprecated": true,
              "description": "Older name of `budgets.query_text`.",
              "minimum": 0,
              "type": [
                "integer",
                "string"
              ],
              "x-env": "NRESE_MAX_QUERY_BYTES",
              "x-older-keys": [
                "policy.limits.max_query_bytes"
              ],
              "x-unit": "bytes"
            },
            "max_query_memory_bytes": {
              "default": "4GiB",
              "deprecated": true,
              "description": "Older name of `budgets.query_memory`.",
              "minimum": 0,
              "type": [
                "integer",
                "string"
              ],
              "x-env": "NRESE_MAX_QUERY_MEMORY_BYTES",
              "x-older-keys": [
                "policy.limits.max_query_memory_bytes"
              ],
              "x-unit": "bytes-or-share"
            },
            "max_rdf_upload_bytes": {
              "default": "128MiB",
              "deprecated": true,
              "description": "Older name of `budgets.upload_size`.",
              "minimum": 0,
              "type": [
                "integer",
                "string"
              ],
              "x-env": "NRESE_MAX_RDF_UPLOAD_BYTES",
              "x-older-keys": [
                "policy.limits.max_rdf_upload_bytes"
              ],
              "x-unit": "bytes"
            },
            "max_update_bytes": {
              "default": "16MiB",
              "deprecated": true,
              "description": "Older name of `budgets.update_size`.",

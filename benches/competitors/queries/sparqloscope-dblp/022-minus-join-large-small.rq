# Sparqloscope 61ad92f, DBLP, query 22: minus-join-large-small
# MINUS JOIN of a large and a small predicate
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> PREFIX dblp: <https://dblp.org/rdf/schema#> SELECT (COUNT(*) AS ?count) WHERE { ?s rdf:type ?o1 MINUS { ?s dblp:formerStreamTitle ?o2 } }

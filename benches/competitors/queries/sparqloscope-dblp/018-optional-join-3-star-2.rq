# Sparqloscope 61ad92f, DBLP, query 18: optional-join-3-star-2
# OPTIONAL JOIN star of three large predicates with the largest sum of join sizes
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> PREFIX dblp: <https://dblp.org/rdf/schema#> SELECT (COUNT(*) AS ?count) WHERE { ?s dblp:signatureOrdinal ?o1 . OPTIONAL { ?s rdf:type ?o2 . ?s dblp:signatureDblpName ?o3 . } }

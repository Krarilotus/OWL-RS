# Sparqloscope 61ad92f, DBLP, query 26: minus-join-2-large-large-with-small-join-result-2
# MINUS JOIN of two large predicates with a small join result
PREFIX dblp: <https://dblp.org/rdf/schema#> SELECT (COUNT(*) AS ?count) WHERE { ?s dblp:publishedInJournalVolume ?o1 . MINUS { ?s dblp:publishedAsPartOf ?o2 } }

# Sparqloscope 61ad92f, DBLP, query 14: optional-join-2-large-large-with-large-result
# OPTIONAL JOIN of two large predicates with a reasonably large join result
PREFIX dblp: <https://dblp.org/rdf/schema#> SELECT (COUNT(*) AS ?count) WHERE { ?s dblp:hasSignature ?o1 . OPTIONAL { ?s dblp:createdBy ?o2 } }

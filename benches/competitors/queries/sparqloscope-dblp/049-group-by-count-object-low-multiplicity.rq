# Sparqloscope 61ad92f, DBLP, query 49: group-by-count-object-low-multiplicity
# GROUP BY with COUNT, for object with low multiplicity
PREFIX dblp: <https://dblp.org/rdf/schema#> SELECT ?object (COUNT(?subject) AS ?count) { ?subject dblp:hasSignature ?object . } GROUP BY ?object ORDER BY DESC(?count) LIMIT 10

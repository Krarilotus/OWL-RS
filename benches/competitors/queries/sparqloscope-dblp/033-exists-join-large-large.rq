# Sparqloscope 61ad92f, DBLP, query 33: exists-join-large-large
# EXISTS JOIN of two large predicates
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> PREFIX dblp: <https://dblp.org/rdf/schema#> SELECT (COUNT(*) AS ?count) WHERE { ?s rdf:type ?o1 FILTER EXISTS { ?s dblp:hasSignature ?o2 } }

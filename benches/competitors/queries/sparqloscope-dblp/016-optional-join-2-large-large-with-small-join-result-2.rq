# Sparqloscope 61ad92f, DBLP, query 16: optional-join-2-large-large-with-small-join-result-2
# OPTIONAL JOIN of two large predicates with a small join result
PREFIX dblp: <https://dblp.org/rdf/schema#> SELECT (COUNT(*) AS ?count) WHERE { ?s dblp:publishedInJournalVolume ?o1 . OPTIONAL { ?s dblp:publishedAsPartOf ?o2 } }

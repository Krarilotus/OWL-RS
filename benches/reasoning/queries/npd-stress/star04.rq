# A star of 4 existential arms on npdv:ExplorationWellbore, one per generating axiom:
# 4 independent tree witnesses, 2^4 branches before the bounds.
PREFIX npdv: <http://sws.ifi.uio.no/vocab/npd-v2#>
SELECT DISTINCT ?w WHERE { ?w a npdv:ExplorationWellbore . ?w npdv:belongsToWell ?v0 . ?w npdv:codeEW ?v1 . ?w npdv:codeNS ?v2 . ?w npdv:dateSyncNPD ?v3 . }

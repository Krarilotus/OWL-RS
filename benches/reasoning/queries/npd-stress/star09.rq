# A star of 9 existential arms on npdv:ExplorationWellbore, one per generating axiom:
# 9 independent tree witnesses, 2^9 branches before the bounds.
PREFIX npdv: <http://sws.ifi.uio.no/vocab/npd-v2#>
SELECT DISTINCT ?w WHERE { ?w a npdv:ExplorationWellbore . ?w npdv:belongsToWell ?v0 . ?w npdv:codeEW ?v1 . ?w npdv:codeNS ?v2 . ?w npdv:dateSyncNPD ?v3 . ?w npdv:dateUpdated ?v4 . ?w npdv:dateUpdatedMax ?v5 . ?w npdv:decimalDegreesEW ?v6 . ?w npdv:decimalDegreesNS ?v7 . ?w npdv:degreesEW ?v8 . }

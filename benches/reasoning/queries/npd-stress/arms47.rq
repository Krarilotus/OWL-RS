# Arms without the class: a star of 47 existential arms on npdv:ExplorationWellbore, one per generating axiom:
# 47 independent tree witnesses, 2^47 branches before the bounds (nothing implies them).
PREFIX npdv: <http://sws.ifi.uio.no/vocab/npd-v2#>
SELECT DISTINCT ?w WHERE { ?w npdv:belongsToWell ?v0 . ?w npdv:codeEW ?v1 . ?w npdv:codeNS ?v2 . ?w npdv:dateSyncNPD ?v3 . ?w npdv:dateUpdated ?v4 . ?w npdv:dateUpdatedMax ?v5 . ?w npdv:decimalDegreesEW ?v6 . ?w npdv:decimalDegreesNS ?v7 . ?w npdv:degreesEW ?v8 . ?w npdv:degreesNS ?v9 . ?w npdv:drillPermit ?v10 . ?w npdv:drillingFacility ?v11 . ?w npdv:drillingOperatorCompany ?v12 . ?w npdv:explorationWellboreForField ?v13 . ?w npdv:explorationWellboreForLicence ?v14 . ?w npdv:factMapURL ?v15 . ?w npdv:factPageURL ?v16 . ?w npdv:idNPD ?v17 . ?w npdv:isDiscoveryWellbore ?v18 . ?w npdv:isMultilateral ?v19 . ?w npdv:isReentryWellbore ?v20 . ?w npdv:mainAreaLocation ?v21 . ?w npdv:minutesEW ?v22 . ?w npdv:minutesNS ?v23 . ?w npdv:name ?v24 . ?w npdv:reclassedFromWellbore ?v25 . ?w npdv:secondsEW ?v26 . ?w npdv:secondsNS ?v27 . ?w npdv:utmEW ?v28 . ?w npdv:utmNS ?v29 . ?w npdv:utmZone ?v30 . ?w npdv:wellOperator ?v31 . ?w npdv:wellboreCompletionYear ?v32 . ?w npdv:wellboreDrillingDays ?v33 . ?w npdv:wellboreEntryYear ?v34 . ?w npdv:wellboreForDiscovery ?v35 . ?w npdv:wellboreKellyBushElevation ?v36 . ?w npdv:wellboreLicensingActivity ?v37 . ?w npdv:wellboreNamePart1 ?v38 . ?w npdv:wellboreNamePart2 ?v39 . ?w npdv:wellboreNamePart4 ?v40 . ?w npdv:wellborePlannedPurpose ?v41 . ?w npdv:wellborePlotSymbol ?v42 . ?w npdv:wellborePurpose ?v43 . ?w npdv:wellboreTotalDepth ?v44 . ?w npdv:wellboreType ?v45 . ?w npdv:wellboreWaterDepth ?v46 . }

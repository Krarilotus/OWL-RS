# OWL2Bench Q10. Find all the instances who has Collaboration with anyother instance. The query performs search across universities.
# Construct: hasCollaborationWith is a Symmetric Object Property. Domain(Person), Range(Person).
# Profiles: QL, RL, DL
PREFIX : <https://kracr.iiitd.edu.in/OWL2Bench#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?x ?y WHERE { ?x :hasCollaborationWith ?y }

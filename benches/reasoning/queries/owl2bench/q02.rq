# OWL2Bench Q2. Find Person instances who are member (Student or Employee) of some Organization.
# Construct: ObjectPropertyChain.
# Profiles: EL, RL, DL
PREFIX : <https://kracr.iiitd.edu.in/OWL2Bench#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?x ?y WHERE { ?x :isMemberOf ?y }

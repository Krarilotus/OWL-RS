PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
PREFIX geof: <http://www.opengis.net/def/function/geosparql/> 
PREFIX geo: <http://www.opengis.net/ont/geosparql#> 

SELECT ?c ?type ?label (geof:distance(?cGeoWKT, "POINT(22.099098510784867 38.46653423317906)"^^geo:wktLiteral, <http://www.opengis.net/def/uom/OGC/1.0/metre>) AS ?distance) ?cGeoWKT 
WHERE { 
   GRAPH <http://geographica.di.uoa.gr/dataset/lgd> { 
      ?c rdf:type lgdo:Motorway; 
         rdfs:label ?label; 
      <http://linkedgeodata.org/ontology/hasGeometry> ?cGeo. 
      ?cGeo <http://linkedgeodata.org/ontology/asWKT> ?cGeoWKT. 
   }
} 
ORDER BY ASC(?distance) 
LIMIT 1

PREFIX geof: <http://www.opengis.net/def/function/geosparql/> 

SELECT ?s1 ?s2
WHERE { 
	GRAPH <http://geographica.di.uoa.gr/dataset/geonames> {
		?s1 <http://www.geonames.org/ontology#asWKT> ?o1
	} 
	GRAPH <http://geographica.di.uoa.gr/dataset/dbpedia> {
		?s2 <http://dbpedia.org/property/asWKT> ?o2
	} 
  	FILTER(geof:sfEquals(?o1, ?o2)).  
}
